# Copy this file to .env and fill in your values.
# Real environment variables always take precedence over this file.
# .env is gitignored — never commit secrets.

# ── LLM providers (set at least one) ─────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── LiteLLM managed proxy (see docs/llm-connector-strategy.md) ──────────────
# Run a local LiteLLM server and point an adapter: openai provider at its
# /v1/chat/completions endpoint. LITELLM_API_KEY is a scoped LiteLLM virtual key
# (not the master key); generate one via LiteLLM's /key/generate endpoint.
LITELLM_API_KEY=

# ── Provider order (comma-separated, first available wins) ───────────────────
# AGENTD_GATEWAY_ORDER=gemini,openai,anthropic,ollama

# ── Model overrides ──────────────────────────────────────────────────────────
# AGENTD_GATEWAY_OPENAI_MODEL=gpt-4o-mini
# AGENTD_GATEWAY_ANTHROPIC_MODEL=claude-3-haiku-20240307
# AGENTD_GATEWAY_GEMINI_MODEL=gemini-2.5-flash

# ── Custom providers (gateway.providers in YAML) ─────────────────────────────
# Custom vendors are not env-only: add a gateway.providers entry in config YAML.
# Example: POOLSIDE_API_KEY= and order including poolside — see config.reference.yaml
# and docs/config-reference.md.
# POOLSIDE_API_KEY=
# AGENTD_GATEWAY_ORDER=poolside,openai

# ── API server ────────────────────────────────────────────────────────────────
# AGENTD_API_ADDRESS=127.0.0.1:8765

# ── Filesystem overrides ─────────────────────────────────────────────────────
# AGENTD_HOME=~/.agentd
