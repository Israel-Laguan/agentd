# Dockerfile.test - Run agentd tests as a non-root user inside a container
#
# Build:  podman build -f Dockerfile.test -t agentd-test .
# Run:    podman run --rm agentd-test
# Run all tests non-root so permission-sensitive tests behave correctly.

FROM golang:1.26-alpine AS tester
WORKDIR /src

# Install sqlite libs so modernc.org/sqlite tests can run.
RUN apk add --no-cache sqlite-libs

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Create a non-root user matching the project's runtime user conventions.
RUN adduser -D -s /bin/bash tester \
    && mkdir -p /tmp/.gocache /tmp/.gomodcache \
    && chown -R tester:tester /src /tmp/.gocache /tmp/.gomodcache
USER tester
ENV GOCACHE=/tmp/.gocache \
    GOMODCACHE=/tmp/.gomodcache \
    GOTOOLCHAIN=local

# Run the same test command the project uses, sans -race (musl + race detector
# requires additional setup; permission tests are the priority here).
CMD ["go", "test", "-v", "-cover", "./..."]
